---
import Icon from './Icon.astro';

interface Props {
  command: string;
}

const { command } = Astro.props;
// A long command wraps at spaces. A word too long for the line, such as a package name on a phone, breaks after a dot.
const words = command.split(' ');
---

<div class="command">
  <code><span class="prompt" aria-hidden="true">$</span> {words.map((w, i) => <Fragment>{i > 0 && ' '}<span class="word">{w.split('.').map((part, j) => <Fragment>{j > 0 && <Fragment>.<wbr /></Fragment>}{part}</Fragment>)}</span></Fragment>)}</code>
  <button type="button" class="copy" data-copy={command} aria-label={`Copy ${command}`} title="Copy">
    <span class="when-idle"><Icon name="copy" /></span>
    <span class="when-done"><Icon name="check" /></span>
  </button>
</div>
