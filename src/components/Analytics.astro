---
// Visit counter, switched on by a repository variable at build time. Without it, as in a fork or on your machine,
// nothing is added and nobody is counted.
// - PostHog: POSTHOG_KEY, and POSTHOG_HOST for the reverse proxy (or the EU cloud). POSTHOG_UI_HOST is the PostHog app
//   the toolbar links back to, needed only for the EU cloud. Cookieless mode stores nothing in the browser, so there's
//   no banner to accept. PostHog tells visitors apart with a hash that changes every day, so a visitor who comes back
//   tomorrow counts as new. Turn on cookieless tracking in the PostHog project settings too, or it drops the events.
// - Three events on top of pageviews: command_copied (a copy button by a dotnet command), code_copied (the copy button
//   on a code block) and outbound_link_clicked (a link to GitHub or NuGet). They're the site's conversion goals.
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST || 'https://us.i.posthog.com';
const posthogUiHost = import.meta.env.PUBLIC_POSTHOG_UI_HOST || 'https://us.posthog.com';
---

{
  posthogKey && (
    <script is:inline define:vars={{ posthogKey, posthogHost, posthogUiHost }}>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init(posthogKey, { api_host: posthogHost, ui_host: posthogUiHost, defaults: '2025-05-24', cookieless_mode: 'always' });
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        const command = target?.closest('button[data-copy]');
        if (command) {
          posthog.capture('command_copied', { command: command.dataset.copy });
          return;
        }
        const code = target?.closest('.expressive-code .copy button');
        if (code) {
          posthog.capture('code_copied', { first_line: (code.dataset.code ?? '').split(/\u007f|\n/)[0].slice(0, 120) });
          return;
        }
        const link = target?.closest('a[href]');
        const destination = link && { 'github.com': 'github', 'www.nuget.org': 'nuget', 'nuget.org': 'nuget' }[link.hostname];
        if (destination) {
          posthog.capture('outbound_link_clicked', { destination, href: link.href });
        }
      });
    </script>
  )
}
