---
// A ring mark from the brand kit, in its dark-background and light-background versions. The theme decides which
// one shows (see .on-dark and .on-light in site.css and docs/theme.css).
interface Props {
  name: string;
  size: number;
  alt?: string;
  class?: string;
  eager?: boolean;
}

const { name, size, alt = '', class: className, eager = false } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
---

<img class:list={[className, 'on-dark']} src={`/logos/${name}.svg`} width={size} height={size} alt={alt} loading={loading} decoding="async" />
<img class:list={[className, 'on-light']} src={`/logos/${name}-light.svg`} width={size} height={size} alt={alt} loading={loading} decoding="async" />
