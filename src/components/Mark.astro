---
// A ring mark from the brand kit.
interface Props {
  name: string;
  size: number;
  alt?: string;
  class?: string;
  eager?: boolean;
}

const { name, size, alt = '', class: className, eager = false } = Astro.props;
---

<img class={className} src={`/logos/${name}.svg`} width={size} height={size} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
