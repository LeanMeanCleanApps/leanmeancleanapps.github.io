---
// Social templates with links to each format.
interface Props {
  files: { file: string; title: string; size: string }[];
  dir?: string;
}
const { files, dir = 'social' } = Astro.props;
const base = `/brand/assets/${dir}`;
// The size reads "1280 × 640", which also gives the image its width and height so the grid doesn't jump as it loads.
const dims = (size: string) => size.split('×').map((n) => n.trim());
---

<div class="cl-social not-content">
  {
    files.map((f) => (
      <figure>
        <img src={`${base}/png/${f.file}.png`} width={dims(f.size)[0]} height={dims(f.size)[1]} alt={f.title} loading="lazy" />
        <figcaption>
          <b>{f.title}</b>
          <span>{f.size}</span>
          <span class="links">
            <a href={`${base}/png/${f.file}.png`}>PNG</a>
            <a href={`${base}/svg/${f.file}.svg`}>SVG</a>
            <a href={`${base}/source/${f.file}.svg`}>Editable SVG</a>
          </span>
        </figcaption>
      </figure>
    ))
  }
</div>
