---
// The five templates and the brand sit at the top of the sidebar, one line each with its ring logo, and the sidebar below belongs to the one you're in.
import Default from '@astrojs/starlight/components/Sidebar.astro';
import { brand, templates } from '../../data/templates';

const { topics } = Astro.locals.starlightSidebarTopics;
const keyOf = (link: string) => link.split('/').filter(Boolean)[0];
---

<nav aria-label="Templates and brand">
  <ul class="cl-topics">
    {
      topics.map((topic) => {
        const key = keyOf(topic.link);
        const logo = key === brand.key ? '/logos/org-spectrum-small-tile.svg' : `/logos/${key}-small.svg`;
        const hue = key === brand.key ? 'org' : key;
        return (
          <li>
            <a
              href={topic.link}
              aria-current={topic.isCurrent ? 'true' : undefined}
              style={`--cl-topic-hue: var(--lmca-${hue})`}
            >
              <img src={logo} alt="" width="24" height="24" />
              <span>{topic.label}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
<Default><slot /></Default>

<style>
  .cl-topics {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    gap: 0.2rem;
  }

  .cl-topics::after {
    content: '';
    display: block;
    margin-top: 0.8rem;
    border-top: 1px solid var(--sl-color-hairline-light);
  }

  .cl-topics a {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    column-gap: 0.6rem;
    align-items: center;
    padding: 0.3rem 0.6rem;
    border-radius: 0.75rem;
    border: 1px solid transparent;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: var(--sl-text-sm);
    font-weight: 600;
  }

  .cl-topics img {
    width: 1.5rem;
    height: 1.5rem;
  }

  .cl-topics a:hover {
    color: var(--sl-color-white);
    border-color: color-mix(in srgb, var(--cl-topic-hue) 45%, transparent);
  }

  .cl-topics a[aria-current='true'] {
    color: var(--sl-color-white);
    border-color: var(--cl-topic-hue);
    background: color-mix(in srgb, var(--cl-topic-hue) 10%, transparent);
  }
</style>
