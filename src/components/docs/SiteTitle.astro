---
// The header shows the template you're reading about, so each one feels like its own site.
import { templates } from '../../data/templates';

const key = Astro.locals.starlightRoute.id.split('/')[0];
const template = templates.find((t) => t.key === key);
const name = template?.name ?? 'Lean Mean Clean Apps';
const href = template ? `/${template.key}/` : '/';
---

<a href={href} class="site-title sl-flex">
  {
    template ? (
      <>
        <img class="light:sl-hidden" src={`/logos/${template.key}-small.svg`} alt="" width="36" height="36" />
        <img class="dark:sl-hidden" src={`/logos/${template.key}-small-light.svg`} alt="" width="36" height="36" />
      </>
    ) : (
      <img src="/logos/org-spectrum-small-tile.svg" alt="" width="36" height="36" />
    )
  }
  <span translate="no">{name}</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 0.6rem;
    font-size: var(--sl-text-h4);
    font-weight: 700;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  span {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  img {
    height: 2.1rem;
    width: auto;
  }
</style>
