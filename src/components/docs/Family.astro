---
// The five Lean Mean Clean Apps templates, each with its own ring logo and colour, linking to its home page.
import { templates } from '../../data/templates';

const current = Astro.url.pathname.split('/').filter(Boolean)[0];
---

<div class="cl-family not-content">
  {
    templates.map((t) => (
      <a href={`/${t.key}/`} aria-current={t.key === current ? 'page' : undefined} style={`--cl-family-hue: var(--lmca-${t.key})`}>
        <img src={`/logos/${t.key}.svg`} alt="" width="64" height="64" />
        <span>
          {t.name}
          <small>{t.subject}</small>
        </span>
      </a>
    ))
  }
</div>
