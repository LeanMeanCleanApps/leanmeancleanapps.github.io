---
// Gives each template's pages its own accent colour and link preview, picked from the first part of the page's path.
import Default from '@astrojs/starlight/components/Head.astro';
import { templates } from '../../data/templates';

const accents = import.meta.glob<string>('../../styles/docs/accents/*.css', { query: '?raw', import: 'default', eager: true });

const key = Astro.locals.starlightRoute.id.split('/')[0];
const template = templates.find((t) => t.key === key);
const accent = template && accents[`../../styles/docs/accents/${template.key}.css`];
const hue = template
  ? `:root { --cl-hue: var(--lmca-${template.key}); } :root[data-theme='light'] { --cl-hue: var(--lmca-${template.hue}-600); }`
  : '';
const image = new URL(template ? `/social/${template.key}.png` : '/og-image.png', Astro.site);
const [width, height] = template ? [1280, 640] : [1200, 630];
---

<Default />
{accent && <style is:inline set:html={accent + hue} />}
<meta property="og:image" content={image} />
<meta property="og:image:width" content={String(width)} />
<meta property="og:image:height" content={String(height)} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={image} />
