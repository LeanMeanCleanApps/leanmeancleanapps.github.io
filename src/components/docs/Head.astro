---
// Gives each template's pages, and the brand pages, their own accent colour and link preview, picked from the first
// part of the page's path.
import Default from '@astrojs/starlight/components/Head.astro';
import Analytics from '../Analytics.astro';
import { brand, templates } from '../../data/templates';

const accents = import.meta.glob<string>('../../styles/docs/accents/*.css', { query: '?raw', import: 'default', eager: true });

const key = Astro.locals.starlightRoute.id.split('/')[0];
const template = templates.find((t) => t.key === key);
const isBrand = key === brand.key;
const accent = (template || isBrand) && accents[`../../styles/docs/accents/${key}.css`];
const hue = template ? `:root { --cl-hue: var(--lmca-${template.key}); }` : isBrand ? ':root { --cl-hue: var(--lmca-org); }' : '';
const image = new URL(template ? `/social/${template.key}.png` : isBrand ? '/brand/assets/social/png/brand.png' : '/og-image.png', Astro.site);
const [width, height] = template || isBrand ? [1280, 640] : [1200, 630];
---

<Default />
{accent && <style is:inline set:html={accent + hue} />}
<meta property="og:image" content={image} />
<meta property="og:image:width" content={String(width)} />
<meta property="og:image:height" content={String(height)} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={image} />
<Analytics />
