---
// Gives each template's pages, and the brand pages, their own accent colour and link preview, picked from the first
// part of the page's path.
import Default from '@astrojs/starlight/components/Head.astro';
import Analytics from '../Analytics.astro';
import { breadcrumbs, graph, softwareSourceCode } from '../../data/structured-data';
import { brand, lightStep, templates } from '../../data/templates';

const accents = import.meta.glob<string>('../../styles/docs/accents/*.css', { query: '?raw', import: 'default', eager: true });

const key = Astro.locals.starlightRoute.id.split('/')[0];
const template = templates.find((t) => t.key === key);
const isBrand = key === brand.key;
const accent = (template || isBrand) && accents[`../../styles/docs/accents/${key}.css`];
// The bright step on dark pages, the deep step on light ones, so the hue reads as text on either.
const scale = template ? template.hue : isBrand ? 'leaf' : '';
const hue = scale
  ? `:root { --cl-hue: var(--lmca-${template ? template.key : 'org'}); } :root[data-theme='light'] { --cl-hue: var(--lmca-${scale}-${lightStep(scale)}); }`
  : '';
// The brand's light accent for amber is step 700, which falls just short on raised backgrounds. Until the brand kit
// changes, use the step the site uses for the hue.
const amber = template?.hue === 'amber' ? ":root[data-theme='light'] { --sl-color-accent: var(--lmca-amber-800); }" : '';
const image = new URL(template ? `/social/${template.key}.png` : isBrand ? '/brand/assets/social/png/brand.png' : '/og-image.png', Astro.site);
const { id, entry } = Astro.locals.starlightRoute;
const isHome = id === key;
const jsonLd = graph(
  template && isHome ? softwareSourceCode(template, entry.data.description ?? template.subject) : undefined,
  breadcrumbs(id, entry.data.title),
);
const [width, height] = template || isBrand ? [1280, 640] : [1200, 630];
const imageAlt = template ? `${template.name}: ${template.subject}` : isBrand ? 'Lean Mean Clean Apps brand guidelines' : 'Lean Mean Clean Apps: Clean Architecture templates for .NET';
---

<Default />
{accent && <style is:inline set:html={accent + hue + amber} />}
<meta property="og:image" content={image} />
<meta property="og:image:width" content={String(width)} />
<meta property="og:image:height" content={String(height)} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:image" content={image} />
<script type="application/ld+json" set:html={jsonLd} />
<Analytics />
